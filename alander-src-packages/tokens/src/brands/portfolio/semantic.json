{
  "color": {
    "background": {
      "page": {
        "$type": "color",
        "$value": "{color.ink.1000}"
      },
      "surface": {
        "$type": "color",
        "$value": "{color.ink.1000}"
      },
      "hero": {
        "$type": "color",
        "$value": "{color.ink.950}"
      },
      "input": {
        "$type": "color",
        "$value": "{color.ink.900}"
      }
    },
    "text": {
      "default": {
        "$type": "color",
        "$value": "{color.paper.100}"
      },
      "strong": {
        "$type": "color",
        "$value": "{color.paper.100}"
      },
      "muted": {
        "$type": "color",
        "$value": "{color.ink.400}"
      },
      "onAction": {
        "$type": "color",
        "$value": "{color.ink.1000}"
      },
      "link": {
        "$type": "color",
        "$value": "{color.purple.300}"
      },
      "brand": {
        "$type": "color",
        "$value": "{color.copper.500}"
      },
      "onHero": {
        "$type": "color",
        "$value": "{color.paper.100}"
      },
      "onHeroAccent": {
        "$type": "color",
        "$value": "{color.purple.300}"
      }
    },
    "border": {
      "default": {
        "$type": "color",
        "$value": "{color.ink.800}"
      },
      "hover": {
        "$type": "color",
        "$value": "{color.ink.600}"
      },
      "focus": {
        "$type": "color",
        "$value": "{color.purple.300}"
      }
    },
    "action": {
      "primary": {
        "$type": "color",
        "$value": "{color.paper.100}"
      },
      "primaryHover": {
        "$type": "color",
        "$value": "{color.paper.300}"
      }
    },
    "feedback": {
      "error": {
        "text": {
          "$type": "color",
          "$value": "{color.copper.500}"
        },
        "background": {
          "$type": "color",
          "$value": "{color.alpha.copper20}"
        }
      }
    },
    "focus": {
      "ring": {
        "$type": "color",
        "$value": "{color.alpha.purple40}"
      }
    }
  },
  "font": {
    "family": {
      "body": {
        "$type": "fontFamily",
        "$value": "{fontFamily.gtPlanar}"
      },
      "heading": {
        "$type": "fontFamily",
        "$value": "{fontFamily.carbonot}"
      },
      "brand": {
        "$type": "fontFamily",
        "$value": "{fontFamily.carbonot}"
      }
    },
    "weight": {
      "heading": {
        "$type": "fontWeight",
        "$value": "{fontWeight.bold}"
      },
      "brand": {
        "$type": "fontWeight",
        "$value": "{fontWeight.bold}"
      }
    },
    "case": {
      "heading": {
        "$type": "other",
        "$value": "uppercase",
        "$description": "Carbonot is set in capitals"
      },
      "brand": {
        "$type": "other",
        "$value": "uppercase"
      }
    }
  },
  "radius": {
    "control": {
      "$type": "dimension",
      "$value": "{radius.sm}"
    },
    "surface": {
      "$type": "dimension",
      "$value": "{radius.none}"
    }
  }
}
