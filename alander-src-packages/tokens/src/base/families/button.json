{
  "$description": "Button and SocialButton. Family tokens point at semantic tokens; a brand overrides one only when this family should differ from the brand's semantic default.",
  "button": {
    "height": {
      "$type": "dimension",
      "$value": "{size.control.height}"
    },
    "radius": {
      "$type": "dimension",
      "$value": "{radius.control}"
    },
    "padding": {
      "x": {
        "$type": "dimension",
        "$value": "{space.inset.md}"
      }
    },
    "gap": {
      "$type": "dimension",
      "$value": "{space.inset.sm}"
    },
    "font": {
      "family": {
        "$type": "fontFamily",
        "$value": "{font.family.body}"
      },
      "size": {
        "$type": "dimension",
        "$value": "{font.size.small}"
      },
      "weight": {
        "$type": "fontWeight",
        "$value": "{font.weight.label}"
      }
    },
    "focusRing": {
      "$type": "color",
      "$value": "{color.focus.ring}"
    },
    "primary": {
      "background": {
        "$type": "color",
        "$value": "{color.action.primary}"
      },
      "backgroundHover": {
        "$type": "color",
        "$value": "{color.action.primaryHover}"
      },
      "text": {
        "$type": "color",
        "$value": "{color.text.onAction}"
      }
    },
    "secondary": {
      "background": {
        "$type": "color",
        "$value": "{color.background.input}"
      },
      "border": {
        "$type": "color",
        "$value": "{color.border.default}"
      },
      "borderHover": {
        "$type": "color",
        "$value": "{color.border.hover}"
      },
      "text": {
        "$type": "color",
        "$value": "{color.text.strong}"
      }
    }
  }
}
