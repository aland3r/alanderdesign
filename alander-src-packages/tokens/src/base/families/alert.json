{
  "$description": "Alert. Family tokens point at semantic tokens; a brand overrides one only when this family should differ from the brand's semantic default.",
  "alert": {
    "radius": {
      "$type": "dimension",
      "$value": "{radius.control}"
    },
    "padding": {
      "x": {
        "$type": "dimension",
        "$value": "{space.inset.md}"
      },
      "y": {
        "$type": "dimension",
        "$value": "{space.inset.sm}"
      }
    },
    "font": {
      "size": {
        "$type": "dimension",
        "$value": "{font.size.small}"
      }
    },
    "error": {
      "background": {
        "$type": "color",
        "$value": "{color.feedback.error.background}"
      },
      "text": {
        "$type": "color",
        "$value": "{color.feedback.error.text}"
      }
    }
  }
}
