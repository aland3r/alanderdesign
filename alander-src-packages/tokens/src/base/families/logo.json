{
  "$description": "Logo. Family tokens point at semantic tokens; a brand overrides one only when this family should differ from the brand's semantic default.",
  "logo": {
    "text": {
      "$type": "color",
      "$value": "{color.text.brand}"
    },
    "font": {
      "family": {
        "$type": "fontFamily",
        "$value": "{font.family.brand}"
      },
      "weight": {
        "$type": "fontWeight",
        "$value": "{font.weight.brand}"
      },
      "case": {
        "$type": "other",
        "$value": "{font.case.brand}"
      }
    },
    "size": {
      "md": {
        "$type": "dimension",
        "$value": "{font.size.body}"
      },
      "lg": {
        "$type": "dimension",
        "$value": "{font.size.title}"
      }
    },
    "gap": {
      "$type": "dimension",
      "$value": "{space.inset.sm}"
    },
    "mark": {
      "background": {
        "$type": "color",
        "$value": "{color.action.primary}"
      },
      "radius": {
        "$type": "dimension",
        "$value": "{radius.control}"
      }
    }
  }
}
