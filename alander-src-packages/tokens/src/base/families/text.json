{
  "$description": "Text and Heading. Family tokens point at semantic tokens; a brand overrides one only when this family should differ from the brand's semantic default.",
  "text": {
    "body": {
      "family": {
        "$type": "fontFamily",
        "$value": "{font.family.body}"
      },
      "lineHeight": {
        "$type": "number",
        "$value": "{font.lineHeight.body}"
      },
      "size": {
        "body": {
          "$type": "dimension",
          "$value": "{font.size.body}"
        },
        "small": {
          "$type": "dimension",
          "$value": "{font.size.small}"
        },
        "caption": {
          "$type": "dimension",
          "$value": "{font.size.caption}"
        }
      },
      "color": {
        "default": {
          "$type": "color",
          "$value": "{color.text.default}"
        },
        "strong": {
          "$type": "color",
          "$value": "{color.text.strong}"
        },
        "muted": {
          "$type": "color",
          "$value": "{color.text.muted}"
        }
      }
    },
    "heading": {
      "family": {
        "$type": "fontFamily",
        "$value": "{font.family.heading}"
      },
      "weight": {
        "$type": "fontWeight",
        "$value": "{font.weight.heading}"
      },
      "lineHeight": {
        "$type": "number",
        "$value": "{font.lineHeight.heading}"
      },
      "case": {
        "$type": "other",
        "$value": "{font.case.heading}"
      },
      "color": {
        "$type": "color",
        "$value": "{color.text.strong}"
      },
      "size": {
        "title": {
          "$type": "dimension",
          "$value": "{font.size.title}"
        },
        "display": {
          "$type": "dimension",
          "$value": "{font.size.display}"
        }
      }
    }
  }
}
