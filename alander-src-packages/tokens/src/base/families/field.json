{
  "$description": "TextField. Family tokens point at semantic tokens; a brand overrides one only when this family should differ from the brand's semantic default.",
  "field": {
    "height": {
      "$type": "dimension",
      "$value": "{size.control.height}"
    },
    "radius": {
      "$type": "dimension",
      "$value": "{radius.control}"
    },
    "padding": {
      "x": {
        "$type": "dimension",
        "$value": "{space.inset.md}"
      }
    },
    "gap": {
      "$type": "dimension",
      "$value": "{space.stack.xs}"
    },
    "background": {
      "$type": "color",
      "$value": "{color.background.input}"
    },
    "text": {
      "$type": "color",
      "$value": "{color.text.strong}"
    },
    "placeholder": {
      "$type": "color",
      "$value": "{color.text.muted}"
    },
    "border": {
      "default": {
        "$type": "color",
        "$value": "{color.border.default}"
      },
      "hover": {
        "$type": "color",
        "$value": "{color.border.hover}"
      },
      "focus": {
        "$type": "color",
        "$value": "{color.border.focus}"
      },
      "error": {
        "$type": "color",
        "$value": "{color.feedback.error.text}"
      }
    },
    "focusRing": {
      "$type": "color",
      "$value": "{color.focus.ring}"
    },
    "label": {
      "text": {
        "$type": "color",
        "$value": "{color.text.strong}"
      },
      "size": {
        "$type": "dimension",
        "$value": "{font.size.small}"
      },
      "weight": {
        "$type": "fontWeight",
        "$value": "{font.weight.label}"
      }
    },
    "hint": {
      "text": {
        "$type": "color",
        "$value": "{color.text.muted}"
      },
      "size": {
        "$type": "dimension",
        "$value": "{font.size.caption}"
      }
    },
    "error": {
      "text": {
        "$type": "color",
        "$value": "{color.feedback.error.text}"
      }
    }
  }
}
