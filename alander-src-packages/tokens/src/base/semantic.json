{
  "$description": "The semantic contract. Every name here is what components read. Brands override only what differs; anything they leave out falls back to this neutral base.",
  "color": {
    "background": {
      "page": {
        "$type": "color",
        "$value": "{color.gray.100}"
      },
      "surface": {
        "$type": "color",
        "$value": "{color.gray.0}"
      },
      "hero": {
        "$type": "color",
        "$value": "{color.gray.50}"
      },
      "input": {
        "$type": "color",
        "$value": "{color.gray.50}"
      }
    },
    "text": {
      "default": {
        "$type": "color",
        "$value": "{color.gray.700}"
      },
      "strong": {
        "$type": "color",
        "$value": "{color.gray.900}"
      },
      "muted": {
        "$type": "color",
        "$value": "{color.gray.600}"
      },
      "onAction": {
        "$type": "color",
        "$value": "{color.white}"
      },
      "link": {
        "$type": "color",
        "$value": "{color.blue.700}"
      },
      "brand": {
        "$type": "color",
        "$value": "{color.gray.900}"
      },
      "onHero": {
        "$type": "color",
        "$value": "{color.gray.900}"
      },
      "onHeroAccent": {
        "$type": "color",
        "$value": "{color.blue.700}"
      }
    },
    "border": {
      "default": {
        "$type": "color",
        "$value": "{color.gray.200}"
      },
      "hover": {
        "$type": "color",
        "$value": "{color.gray.500}"
      },
      "focus": {
        "$type": "color",
        "$value": "{color.blue.700}"
      }
    },
    "action": {
      "primary": {
        "$type": "color",
        "$value": "{color.gray.900}"
      },
      "primaryHover": {
        "$type": "color",
        "$value": "{color.gray.700}"
      }
    },
    "feedback": {
      "error": {
        "text": {
          "$type": "color",
          "$value": "{color.red.700}"
        },
        "background": {
          "$type": "color",
          "$value": "{color.red.50}"
        }
      }
    },
    "focus": {
      "ring": {
        "$type": "color",
        "$value": "{color.alpha.blue35}"
      }
    }
  },
  "font": {
    "size": {
      "caption": {
        "$type": "dimension",
        "$value": "{fontSize.12}"
      },
      "small": {
        "$type": "dimension",
        "$value": "{fontSize.14}"
      },
      "body": {
        "$type": "dimension",
        "$value": "{fontSize.16}"
      },
      "title": {
        "$type": "dimension",
        "$value": "{fontSize.32}"
      },
      "display": {
        "$type": "dimension",
        "$value": "{fontSize.40}"
      },
      "headline": {
        "$description": "Landing-page highlight text. Mobile below 768px, tablet from 768px, desktop from 1024px.",
        "mobile": {
          "$type": "dimension",
          "$value": "{fontSize.32}"
        },
        "tablet": {
          "$type": "dimension",
          "$value": "{fontSize.48}"
        },
        "desktop": {
          "$type": "dimension",
          "$value": "{fontSize.56}"
        }
      }
    },
    "weight": {
      "body": {
        "$type": "fontWeight",
        "$value": "{fontWeight.regular}"
      },
      "label": {
        "$type": "fontWeight",
        "$value": "{fontWeight.semibold}"
      },
      "heading": {
        "$type": "fontWeight",
        "$value": "{fontWeight.semibold}"
      },
      "brand": {
        "$type": "fontWeight",
        "$value": "{fontWeight.semibold}"
      }
    },
    "lineHeight": {
      "body": {
        "$type": "number",
        "$value": "{lineHeight.normal}"
      },
      "heading": {
        "$type": "number",
        "$value": "{lineHeight.tight}"
      }
    },
    "family": {
      "body": {
        "$type": "fontFamily",
        "$value": "{fontFamily.system}"
      },
      "heading": {
        "$type": "fontFamily",
        "$value": "{fontFamily.system}"
      },
      "brand": {
        "$type": "fontFamily",
        "$value": "{fontFamily.system}"
      },
      "headline": {
        "$type": "fontFamily",
        "$value": "{font.family.heading}"
      }
    },
    "case": {
      "heading": {
        "$type": "other",
        "$value": "none"
      },
      "brand": {
        "$type": "other",
        "$value": "none"
      }
    }
  },
  "radius": {
    "control": {
      "$type": "dimension",
      "$value": "{radius.md}"
    },
    "surface": {
      "$type": "dimension",
      "$value": "{radius.lg}"
    }
  },
  "space": {
    "inset": {
      "sm": {
        "$type": "dimension",
        "$value": "{space.2}"
      },
      "md": {
        "$type": "dimension",
        "$value": "{space.4}"
      },
      "lg": {
        "$type": "dimension",
        "$value": "{space.6}"
      }
    },
    "stack": {
      "xs": {
        "$type": "dimension",
        "$value": "{space.2}"
      },
      "sm": {
        "$type": "dimension",
        "$value": "{space.4}"
      },
      "md": {
        "$type": "dimension",
        "$value": "{space.5}"
      },
      "lg": {
        "$type": "dimension",
        "$value": "{space.6}"
      },
      "xl": {
        "$type": "dimension",
        "$value": "{space.8}"
      }
    }
  },
  "size": {
    "control": {
      "height": {
        "$type": "dimension",
        "$value": "{size.control.md}"
      }
    }
  }
}
